{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Handmade felt doll product item details",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the product" },
        "category": { "type": "string", "enum": ["felt-doll", "keyring", "mini-doll", "seasonal", "custom"] },
        "price": { "type": "number", "description": "Price of the product in KRW" },
        "description": { "type": "string", "description": "Detailed description of the product" },
        "images": { "type": "array", "description": "List of image URLs" },
        "stock": { "type": "number", "description": "Available inventory" },
        "salesCount": { "type": "number", "description": "Number of items sold" },
        "rating": { "type": "number", "description": "Average rating" },
        "reviewsCount": { "type": "number", "description": "Total number of reviews" },
        "isBest": { "type": "boolean", "description": "Whether it is a best-selling product" },
        "isNew": { "type": "boolean", "description": "Whether it is a new product" },
        "createdAt": { "type": "number", "description": "Timestamp when the product was created" }
      },
      "required": ["name", "category", "price", "description", "images", "stock", "salesCount", "rating", "reviewsCount", "createdAt"]
    },
    "FAQ": {
      "title": "FAQ",
      "description": "Frequently Asked Questions for care, shipping, custom orders, etc.",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string", "enum": ["order", "custom", "shipping", "care"] }
      },
      "required": ["question", "answer", "category"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Announcements and notice posts for store events or schedules",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string", "enum": ["notice", "event", "shipping", "restock"] },
        "createdAt": { "type": "number" },
        "views": { "type": "number" }
      },
      "required": ["title", "content", "category", "createdAt", "views"]
    },
    "Review": {
      "title": "Review",
      "description": "Reviews written by users for products",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "isBest": { "type": "boolean" }
      },
      "required": ["productId", "productName", "userId", "userName", "rating", "content", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stored user preferences, point balances, coupons, and check-in history",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "points": { "type": "number" },
        "coupons": { "type": "array" },
        "attendanceHistory": { "type": "array" },
        "attendanceStreak": { "type": "number" },
        "birthday": { "type": "string" },
        "invitedBy": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "points", "coupons", "attendanceHistory", "attendanceStreak", "role", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase orders for ready-made items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "items": { "type": "array" },
        "totalPrice": { "type": "number" },
        "discountAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "pointsUsed": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["bank_transfer"] },
        "paymentInfo": { "type": "object" },
        "status": { "type": "string", "enum": ["pending", "preparing", "making", "shipping", "delivered", "cancelled"] },
        "shippingAddress": { "type": "object" },
        "trackingNumber": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userEmail", "userName", "items", "totalPrice", "discountAmount", "paidAmount", "pointsUsed", "pointsEarned", "paymentMethod", "paymentInfo", "status", "shippingAddress", "createdAt"]
    },
    "CustomOrder": {
      "title": "CustomOrder",
      "description": "Inquiries and order status for custom bespoke items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "style": { "type": "string" },
        "size": { "type": "string", "enum": ["small", "medium", "large"] },
        "color": { "type": "string" },
        "memo": { "type": "string" },
        "isGiftWrap": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending_estimate", "estimated", "paid", "preparing", "making", "completed", "shipping", "delivered"] },
        "estimatePrice": { "type": "number" },
        "adminMemo": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userEmail", "userName", "imageUrl", "style", "size", "color", "memo", "isGiftWrap", "status", "createdAt"]
    },
    "EventLog": {
      "title": "EventLog",
      "description": "Store mini-game event logs (roulette rewards, check-in history, etc.)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "eventType": { "type": "string", "enum": ["roulette", "giveaway", "attendance"] },
        "reward": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "userEmail", "eventType", "reward", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "General settings for the storefront",
      "type": "object",
      "properties": {
        "homeImage": { "type": "string", "description": "URL of the primary hero home image" }
      },
      "required": ["homeImage"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Periodic subscription orders for handmade felt dolls or DIY kits",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "packageName": { "type": "string", "enum": ["sprout", "petal", "master", "experience"] },
        "packageLabel": { "type": "string" },
        "price": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paused", "cancelled"] },
        "deliveryCycle": { "type": "string", "enum": ["monthly"] },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string", "enum": ["bank_transfer", "none"] },
        "createdAt": { "type": "number" },
        "nextDeliveryDate": { "type": "string" }
      },
      "required": ["userId", "userEmail", "userName", "packageName", "packageLabel", "price", "status", "deliveryCycle", "shippingAddress", "paymentMethod", "createdAt", "nextDeliveryDate"]
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Available products in the handcraft store" },
    "faqs": { "schema": "FAQ", "description": "Store FAQs" },
    "notices": { "schema": "Notice", "description": "Announcements and Notice posts" },
    "reviews": { "schema": "Review", "description": "Product ratings and content reviews" },
    "users": { "schema": "UserProfile", "description": "User profiles, roles, and statistics" },
    "orders": { "schema": "Order", "description": "Standard shopping purchase records" },
    "custom_orders": { "schema": "CustomOrder", "description": "Custom orders submitted by users" },
    "event_logs": { "schema": "EventLog", "description": "History of events played by users" },
    "settings": { "schema": "StoreSettings", "description": "General application/storefront configurations" },
    "subscriptions": { "schema": "Subscription", "description": "Periodic subscription records" }
  }
}
